rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users profile collection
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Public Leaderboards collection
    match /leaderboards/{leaderboardId} {
      allow read: if true;
      allow write: if true;
    }

    // Multiplayer Rooms collection (real-time state synchronization)
    match /rooms/{roomCode} {
      allow read, write: if true;
    }

    // Game Sessions and match history
    match /gameSessions/{sessionId} {
      allow read, write: if true;
    }
  }
}

